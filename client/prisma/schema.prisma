generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bookmark {
  id          String   @id @default(cuid())
  url         String
  title       String?
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now())

  userId String

  tags        Tag[]
  collections CollectionBookmark[]

  @@index([userId])
}

model Tag {
  id   String @id @default(cuid())
  name String

  bookmarkId String
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@unique([bookmarkId, name])
}

model Collection {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String

  bookmarks CollectionBookmark[]

  @@index([userId])
}

model CollectionBookmark {
  collectionId String
  bookmarkId   String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bookmark   Bookmark   @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@id([collectionId, bookmarkId])
}

// When each user's next digest is due. Users live in Supabase Auth, so this is keyed by their
// auth id rather than a relation. See docs/specs/P2.8-digest-local-time.md.
model DigestSchedule {
  userId       String    @id
  timeZone     String // IANA name from the user's browser, e.g. "Asia/Kolkata"; never an offset
  nextDigestAt DateTime // UTC moment of the user's next local 8 am
  lastSentAt   DateTime?

  @@index([nextDigestAt])
}
